// .devcontainer/devcontainer.json
{
  "name": "bifrost",
  // Compose, purely to control naming: container `bifrost`, image `vsc-bifrost`.
  // The base image (plain Ubuntu LTS, not dotnet:11.0-preview — that tag is stuck on
  // preview 6, built 2026-07-30) is in .devcontainer/Dockerfile; everything else is
  // features below.
  "dockerComposeFile": "docker-compose.yml",
  "service": "bifrost",
  // Nested one level inside the mounted NorseArchitecture folder (see docker-compose.yml's
  // volumes comment) — VS Code/terminal cwd and Claude Code's project-root resolution both
  // follow this, so every contributor's session still lands in Bifrost and still picks up
  // its CLAUDE.md/.claude/settings.json automatically, while ../.github and ../Glitnir
  // (referenced by sibling-relative path from realm CLAUDE.md files) now actually resolve.
  "workspaceFolder": "/workspaces/NorseArchitecture/Bifrost",

  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {},
    // base:ubuntu is Ubuntu 26.04 (resolute) as of 2026-08. Microsoft ships no
    // moby-* packages for resolute, so this takes Docker CE from download.docker.com
    // instead. Pinning the image to :ubuntu-24.04 would let moby default back on.
    "ghcr.io/devcontainers/features/docker-in-docker:4": {
        "moby": false
    },
    // The only SDK in the container. Preview 7 is the last preview — bump this line
    // to 11.0.100-rc.1.* when RC1 drops, then rc.2, then RTM.
    // The ASP.NET Core 10 runtime is not for our code — it's what the C# extension's
    // Roslyn language server runs on. Baking it into the image (one layer, cached)
    // stops the extension re-downloading its own private copy into ~/.vscode-server
    // on every single rebuild. See dotnetAcquisitionExtension.* below.
    "ghcr.io/devcontainers/features/dotnet:2": {
        "version": "11.0.100-preview.7.26381.103",
        "aspNetCoreRuntimeVersions": "10.0"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    // scripts/*.ps1 (sync-the-realms, pull-the-images, summarize-the-branches,
    // Verify-Runes) and Ginnungagap's scatter-the-runes.ps1 need pwsh to run at all —
    // it wasn't in the image before this.
    "ghcr.io/devcontainers/features/powershell:2": {},
    "ghcr.io/devcontainers/features/node:2": {
        "version": "24",
        "npmVersion": "12"
    },
    // Not used by anything in-repo yet — added ahead of a planned CSnakes integration
    // (embeds Python in a .NET process). Revisit the pinned version against whatever
    // CSnakes requires when that lands.
    "ghcr.io/devcontainers/features/python:1": {
        "version": "3.14"
    },
    "ghcr.io/dirien/devcontainer-feature-codex/codex:0": {}
  },

  // The shared caches are declared external in docker-compose.yml, and compose refuses
  // to create external volumes itself. Idempotent — `docker volume create` on an
  // existing volume just prints its name. Runs on the host, before the build.
  // /var/lib/docker is deliberately not mounted anywhere here: docker-in-docker binds
  // its own dind-var-lib-docker-${devcontainerId} volume there, and a second mount on
  // the same target is a hard "Duplicate mount point" failure at container create.
  "initializeCommand": {
    "nuget-cache-volume": "docker volume create norse-nuget",
    "npm-cache-volume": "docker volume create norse-npm",
    "dotnet-certs-volume": "docker volume create norse-dotnet-certs"
  },

  // Statically declared so VS Code's forwarding is deterministic instead of purely
  // heuristic auto-detection — an undeclared port can silently remap (e.g. 5002 -> 50020)
  // if VS Code thinks the "real" host port is already taken by a stale forward. These are
  // the AppHost's own fixed, unproxied ports (see Orchestration.AppHost/AppHost.cs and its
  // WithContainerDefaults/WithHostPort usage) plus Aspire's own dashboard ports — not the
  // dynamic per-project Kestrel ports DCP proxies behind them.
  "forwardPorts": [5000, 5001, 5002, 5050, 5432, 5433, 21000],
  "portsAttributes": {
    "5000": { "label": "Aspire Dashboard", "requireLocalPort": true, "protocol": "https" },
    "5001": { "label": "web", "requireLocalPort": true, "protocol": "https" },
    "5002": { "label": "stories", "requireLocalPort": true, "protocol": "https" },
    "5050": { "label": "pgAdmin", "requireLocalPort": true, "protocol": "http" },
    "5432": { "label": "pg-primary", "requireLocalPort": true },
    "5433": { "label": "pg-replica", "requireLocalPort": true },
    "21000": { "label": "Aspire OTLP/gRPC", "requireLocalPort": true, "protocol": "https" }
  },

  "remoteEnv": {
    // Feeds NuGet.Config's <github> source (packageSourceCredentials %NUGET_AUTH_TOKEN%,
    // scoped via packageSourceMapping to Norse.* and Npgsql.EntityFrameworkCore.* — the
    // rest resolves from nuget.org). Needs a GitHub PAT (classic, read:packages scope,
    // NorseArchitecture org access) set as NUGET_AUTH_TOKEN in the host environment
    // before the container starts — this only forwards it in, it doesn't supply it.
    "NUGET_AUTH_TOKEN": "${localEnv:NUGET_AUTH_TOKEN}",
    // Per-contributor git identity, forwarded the same way as NUGET_AUTH_TOKEN above.
    // Set GIT_USER_NAME/GIT_USER_EMAIL in the host environment before the container
    // starts; configure-git-ssh-signing.sh applies them to git config --global and,
    // once set, builds ~/.ssh/allowed_signers from GIT_USER_EMAIL plus whatever key
    // the forwarded SSH agent is holding. Unset means the script skips both steps.
    "GIT_USER_NAME": "${localEnv:GIT_USER_NAME}",
    "GIT_USER_EMAIL": "${localEnv:GIT_USER_EMAIL}",
    "NUGET_PACKAGES": "/home/vscode/.nuget/packages",
    // Redirect build churn off the 9p mount onto container-native disk
    "NORSE_CONTAINER_BUILD": "1",
    // inotify doesn't cross the mount; anything watching must poll
    "DOTNET_USE_POLLING_FILE_WATCHER": "1",
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1"
  },

  // Object form runs these concurrently; they're independent — except apt-get, which
  // isn't safe to run from two entries at once (dpkg lock contention races
  // /var/lib/dpkg/lock-frontend and randomly fails whichever entry loses). Every
  // apt-using step below lives in the single "dev-cert-trust" entry for that reason.
  "postCreateCommand": {
    // Fresh named volumes land root-owned when the target doesn't exist in the image,
    // which fails `dotnet restore` / `npm i` for the vscode user until it's chowned.
    // Also chowns .cache itself (not just its ms-playwright child, mounted below) —
    // mounting norse-playwright-browsers at a nested path makes Docker create the
    // .cache parent as root, which then blocks anything else vscode wants to write
    // there, e.g. the C# Dev Kit's Roslyn language server creating its own
    // "Microsoft DevDiv" telemetry-id cache dir.
    "caches": "sudo chown vscode:vscode /home/vscode/.cache && sudo chown -R vscode:vscode /home/vscode/.nuget /home/vscode/.npm",
    // ${containerWorkspaceFolder} covers Bifrost itself; .github (Ginnungagap) is a
    // separate host-level clone bind-mounted as a sibling (see docker-compose.yml's
    // volumes comment) and lands root-owned through that mount, so git's dubious-
    // ownership check rejects it too until it's added explicitly.
    "safe-directory": "git config --global --add safe.directory ${containerWorkspaceFolder} && git config --global --add safe.directory ${containerWorkspaceFolder}/../.github",
    // SSH agent forwarding itself needs no config here -- VS Code auto-forwards
    // whatever agent is running on the host (Bitwarden's bridge on WSL2/Fedora,
    // the native agent on Windows) into SSH_AUTH_SOCK. This just does the part
    // that isn't automatic: pointing git's SSH-based commit/tag signing at
    // whatever key that forwarded agent is holding. See the script for why it's
    // non-blocking when no agent/key is present yet.
    "git-ssh-signing": "bash ${containerWorkspaceFolder}/.devcontainer/configure-git-ssh-signing.sh",
    // posh-git isn't part of the powershell feature -- installed from the gallery here.
    "posh-git": "pwsh -NoLogo -NoProfile -File ${containerWorkspaceFolder}/.devcontainer/configure-posh-git.ps1",
    // npm 12 blocks lifecycle scripts unless the package is named in allow-scripts, so
    // the claude-code feature's `npm install -g` silently skips the postinstall that
    // places the native binary — `claude` then exits with "native binary not installed".
    // This runs that postinstall directly. Drop it if the feature turns npm-12-aware,
    // or if npm gets pinned back to 11.
    "claude-native-binary": "sudo \"$(command -v node)\" \"$(npm root -g)/@anthropic-ai/claude-code/install.cjs\"",
    // The dirien codex feature installs @openai/codex globally during image build, as
    // root — everything else under lib/node_modules is vscode:nvm (group-writable), but
    // @openai/codex itself lands root:nvm, so `npm install -g @openai/codex` as vscode
    // (e.g. to self-update) fails renaming the old dir out of the way: EACCES. Chown the
    // whole global node_modules tree rather than just @openai, in case a later feature
    // adds another package the same way.
    "codex-ownership": "sudo chown -R vscode:nvm \"$(npm root -g)\"",
    // Own chown+generate chain (not folded into "caches" above) so it never races that
    // entry's chown under the concurrent object-form execution. Generates (or reuses, once
    // norse-dotnet-certs makes the store persistent) the ASP.NET Core dev cert, trusts it
    // for in-container callers, and exports the public cert (no private key, no password —
    // see .devcontainer/certs/aspnetcore-dev.crt) for the one-time Windows-side trust step
    // in scripts/Trust-DevCert.ps1. Linux chain trust via update-ca-certificates is best
    // effort — see README's HTTPS dev cert trust section for why some internal HttpClient
    // callers route around it via ASPIRE_ALLOW_UNSECURED_TRANSPORT instead.
    // Chown targets the whole ~/.dotnet tree, not just corefx/cryptography: the dotnet
    // feature's image-build step leaves ~/.dotnet itself root-owned, and `dotnet dev-certs`
    // writes a first-run sentinel file directly under it before touching the cert store —
    // narrowing this to the cryptography subdir left that sentinel write failing with
    // UnauthorizedAccessException, taking down the whole postCreateCommand step.
    // `--trust` itself exits 4 on this base image — no NSS/certutil trust store for
    // dotnet dev-certs to register into (that store is installed further down this same
    // chain, but doesn't exist yet at the point --trust runs) — even though the export
    // it's bundled with still succeeds. `|| true` swallows that so the chain reaches the
    // cp + update-ca-certificates pair, which is the actual Linux trust mechanism for
    // curl/HttpClient/openssl-backed callers per the comment above.
    // The apt/certutil tail imports the same cert into the NSS shared DB at ~/.pki/nssdb
    // (trusted-peer flag "P,," — this is a CA:FALSE leaf/self-signed cert, not a CA, so
    // NSS's "C,," CA-trust flag builds no chain from it and silently leaves it untrusted).
    // chromium rides the same apt-get install as libnss3-tools (not a separate entry —
    // see the postCreateCommand-level comment above on why apt can't be split out).
    // Debian's actual browser package is `chromium`, not Ubuntu's `chromium-browser`.
    // Real system Chromium (not Playwright's own downloaded Chrome-for-Testing build) for
    // the Playwright MCP server (.mcp.json, --executable-path /usr/bin/chromium) to drive
    // against localhost sites from inside the container.
    // `dpkg --configure -a` guards against a dpkg left "interrupted" by something outside
    // this command's control (container pause/rebuild, OOM, etc. mid-transaction on a
    // previous run) — an interrupted dpkg fails every subsequent apt-get in this chain,
    // including this one, until it's reconciled; `|| true` because a clean dpkg state has
    // nothing to configure and exits non-zero for that, which isn't a real failure here.
    "dev-cert-trust": "sudo chown -R vscode:vscode /home/vscode/.dotnet && mkdir -p ${containerWorkspaceFolder}/.devcontainer/certs && (dotnet dev-certs https --trust --export-path ${containerWorkspaceFolder}/.devcontainer/certs/aspnetcore-dev.crt --format PEM || true) && sudo cp ${containerWorkspaceFolder}/.devcontainer/certs/aspnetcore-dev.crt /usr/local/share/ca-certificates/aspnetcore-dev.crt && sudo update-ca-certificates && (sudo dpkg --configure -a || true) && sudo apt-get update -qq && sudo apt-get install -y -qq libnss3-tools chromium && mkdir -p ~/.pki/nssdb && ([ -f ~/.pki/nssdb/cert9.db ] || certutil -d sql:$HOME/.pki/nssdb -N --empty-password) && (certutil -d sql:$HOME/.pki/nssdb -D -n aspnetcore-dev || true) && certutil -d sql:$HOME/.pki/nssdb -A -t \"P,,\" -n aspnetcore-dev -i ${containerWorkspaceFolder}/.devcontainer/certs/aspnetcore-dev.crt"
  },

  "customizations": {
    "vscode": {
      "extensions": ["ms-dotnettools.csdevkit"],
      "settings": {
        // Point the .NET Install Tool at the container's own install so csharp/csdevkit
        // stop acquiring private runtimes under ~/.vscode-server. Shared form covers
        // every extension that asks; the per-extension array form is
        // dotnetAcquisitionExtension.existingDotnetPath if this ever needs splitting.
        "dotnetAcquisitionExtension.sharedExistingDotnetPath": "/usr/share/dotnet/dotnet"
      }
    }
  }
}
