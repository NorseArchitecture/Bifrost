<Project>
	<Choose>
		<When Condition="'$(UseProjectReferences)' == 'true'">
			<ItemGroup Condition="'@(NorseRef)' != ''">
				<ProjectReference Include="@(NorseRef->'$(MSBuildThisFileDirectory)%(Repo)/src/%(Identity)/%(Identity).csproj')" />
				<ProjectReference Include="@(NorseRef->WithMetadataValue('Generator', 'true')->'$(MSBuildThisFileDirectory)%(Repo)/gen/%(Identity).Generator/%(Identity).Generator.csproj')" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
			</ItemGroup>
			<ItemGroup Condition="'@(NorseDesignRef)' != ''">
				<ProjectReference Include="@(NorseDesignRef->'$(MSBuildThisFileDirectory)%(Repo)/src/%(Identity)/%(Identity).csproj')">
					<PrivateAssets>all</PrivateAssets>
				</ProjectReference>
			</ItemGroup>
		</When>
		<When Condition="'$(ManagePackageVersionsCentrally)' == 'true'">
			<ItemGroup>
				<PackageReference Include="@(NorseRef->'Norse.%(Identity)')" />
				<PackageReference Include="@(NorseDesignRef->'Norse.%(Identity)')">
					<PrivateAssets>all</PrivateAssets>
				</PackageReference>
			</ItemGroup>
		</When>
		<Otherwise>
			<ItemGroup>
				<PackageReference Include="@(NorseRef->'Norse.%(Identity)')" Version="$(NorseRefVersion)" />
				<PackageReference Include="@(NorseDesignRef->'Norse.%(Identity)')" Version="$(NorseRefVersion)">
					<PrivateAssets>all</PrivateAssets>
				</PackageReference>
			</ItemGroup>
		</Otherwise>
	</Choose>
	<!--
		The duplicate-generator strip target (Gap 2 in the design doc below) lives in the
		Ginnungagap-scattered src/tests Directory.Build.targets templates, not here — it must also
		work in a genuinely standalone checkout with no Bifrost ancestor, which this file can never
		be part of by definition. Full design:
		Glitnir/docs/Platform/specs/2026-07-01-norseref-generator-forwarding-design.md
	-->
</Project>
